# =================================================================
# CosmosWiki Global Environment Variables Template
# 
# [사용 방법]
# 1. 본 파일(.env.example)을 복사하여 동일한 위치에 '.env' 파일을 생성합니다.
# 2. 아래의 빈 칸에 본인의 실제 API Key 및 URL 주소를 입력합니다.
# 3. 'python run.py'를 실행하면 백엔드와 프론트엔드에 자동으로 분배됩니다.
# =================================================================

# Google Gemini API Configuration
# Google AI Studio(https://aistudio.google.com/)에서 발급받은 API 키를 입력하세요.
GEMINI_API_KEY=your_gemini_api_key_here

# Local SQLite Database Configuration
# 비워두면 backend/data/cosmos.db 경로를 기본값으로 사용합니다.
LOCAL_DB_PATH=

# Frontend Connection Configuration
# Next.js 프론트엔드가 참조할 FastAPI 백엔드 API 서버의 전체 주소를 입력하세요.
# - 로컬 환경 기본값: http://localhost:8000
# - GitHub Codespaces 사용 시 포트 포워딩된 8000번 전체 URL 주소 입력
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000